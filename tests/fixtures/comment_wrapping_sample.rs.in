// FIXME: Short FIXME.
// NOTE: The tests below use `assert_eq!` rather than `assert!` wherever possible, because `assert_eq!` prints both values when it fails.
// HACK: None.
// XXX: None either.

/* A plain block comment on one line. */

/*
 * A plain multi-line block comment with leading asterisks. It is wrapped the same way as a block doc comment, so this line should be wrapped to the configured width.
 * /* Rust allows block comments to nest, unlike C, so this inner comment does not end the outer one. */
 */

/* Text after the opening delimiter keeps this block comment from being wrapped.
// A line comment inside a block comment is part of the block comment, so it must not be wrapped or combined with the line below it.
// This is the line below it.
*/

#[test]
fn push_and_pop() {
    let mut buffer = RingBuffer::with_capacity(3).unwrap();
    assert!(buffer.is_empty());

    // Fill the buffer completely and check that the next push fails.
    for value in 1..=3 {
        buffer.push(value).unwrap();
    }
    assert!(buffer.is_full());
    assert_eq!(buffer.len(), 3);
    assert_eq!(buffer.push(4), Err(Error::Full { capacity: 3 }));

    // Pop everything and check the order.
    assert_eq!(buffer.pop(), Some(1));
    assert_eq!(buffer.pop(), Some(2));
    assert_eq!(buffer.pop(), Some(3));
    assert_eq!(buffer.pop(), None);
    assert_eq!(buffer.try_pop(), Err(Error::Empty));
}

#[test]
fn force_push_evicts_the_oldest_value() {
    let mut buffer = RingBuffer::with_capacity(2).unwrap();
    assert_eq!(buffer.force_push('a'), None);
    assert_eq!(buffer.force_push('b'), None);
    assert_eq!(buffer.force_push('c'), Some('a')); // 'a' was the oldest
    assert_eq!(buffer.iter().copied().collect::<Vec<_>>(), ['b', 'c']);
    assert_eq!(buffer.iter().len(), 2);
}

#[test]
fn indexing() {
    let mut buffer = RingBuffer::with_capacity(4).unwrap();
    for value in 10..16 {
        buffer.force_push(value);
    }
    assert_eq!(buffer.peek(), Some(&12));
    assert_eq!(buffer.get(3), Some(&15));
    assert_eq!(buffer.get(4), None);

    // SAFETY: `1 < buffer.len()`.
    let second = unsafe { buffer.get_unchecked(1) };
    assert_eq!(*second, 13);
}

#[test]
fn errors_display_helpful_messages() {
    let cases = [
        (Error::Full { capacity: 8 }, "ring buffer is full (capacity 8)"),
        (Error::Empty, "ring buffer is empty"),
        // The expected message embeds `MAX_CAPACITY`, so it is built with `format!` instead of being written out as a literal that would go stale if the constant ever changed.
        (
            Error::InvalidCapacity(0),
            &*format!("invalid capacity 0; expected 1..={MAX_CAPACITY}"),
        ),
    ];
    for (error, expected) in cases {
        assert_eq!(error.to_string(), expected);
    }
    assert!(RingBuffer::<()>::with_capacity(MAX_CAPACITY + 1).is_err());
}

#[test]
fn priorities() {
    let all = [Priority::Low, Priority::Normal, Priority::High, Priority::Critical];
    let urgent: Vec<_> = all.into_iter().filter(|p| p.is_urgent()).collect();
    assert_eq!(urgent, [Priority::High, Priority::Critical]);
    assert!(Priority::Low < Priority::Critical); // variants are ordered by declaration
}

#[test]
fn config_policies() {
    let strict = Config {
        capacity: 1,
        name: "strict".to_owned(),
        ..Config::default()
    };
    let lossy = Config {
        overwrite: true,
        priority: Priority::Low,
        ..strict.clone()
    };
    assert_eq!(strict.priority, Priority::Normal);
    assert_eq!(lossy.name, "strict");

    let mut buffer = strict.build().unwrap();
    assert_eq!(strict.insert(&mut buffer, 1), Ok(None));
    assert_eq!(strict.insert(&mut buffer, 2), Err(Error::Full { capacity: 1 }));
    assert_eq!(lossy.insert(&mut buffer, 3), Ok(Some(1)));

    /* Known limitation (the tool cannot distinguish code from prose): the commented-out code below is joined with the prose. */
    // let mut big = Config { capacity: MAX_CAPACITY, ..Config::default() }.build::<u64>().unwrap();
    // big.force_push(0);
    // assert_eq!(big.len(), 1);
    // The three lines above are commented-out code. Combining them into a paragraph would be wrong, but nothing distinguishes them from prose except that they look like code.
}

#[test]
fn macro_forms() {
    let empty: RingBuffer<u8> = ring![];
    assert_eq!(empty.capacity(), DEFAULT_CAPACITY);

    let mut listed = ring![1, 2, 3,];
    assert_eq!(listed.drain_all(), [1, 2, 3]);

    let repeated = ring![7_u8; 3];
    assert!(repeated.is_full());
    assert!(repeated.iter().all(|&v| v == 7));
}

#[test]
fn checksums() {
    for (input, expected) in KNOWN_CHECKSUMS {
        assert_eq!(checksum::fletcher16(input), expected, "input {input:?}");
    }
}

#[test]
fn comment_markers_inside_strings_are_not_comments() {
    assert!(GREETING.contains("//"));

    /* Known limitation (the tool does not parse Rust syntax): the `///` lines inside the raw string below are wrapped. */
    // The lines inside this raw string look exactly like doc comments, but they are part of a string literal. A tool that rewrites them changes the program's behavior.
    let source = r"
/// This line is inside a raw string literal and is much longer than the configured maximum width, so a tool that does not track string literals will wrap it.
/// So will this one, which is short.
";
    assert_eq!(source.lines().filter(|line| line.starts_with("///")).count(), 2);
}

#[test]
fn deeply_nested_comments() {
    let mut buffer = RingBuffer::with_capacity(8).unwrap();
    for round in 0..5 {
        match round % 2 {
            0 => {
                let push_all = |buffer: &mut RingBuffer<i32>| {
                    for value in 0..round {
                        if value % 2 == 0 {
                            // This comment is indented by twenty-eight spaces, which leaves much less room for text than a comment at the start of a line, so it wraps sooner.
                            buffer.force_push(value);
                        }
                    }
                };
                push_all(&mut buffer);
            }
            // A comment between match arms, at the same indentation as the arm patterns.
            _ => {
                buffer.pop();
            }
        }
    }
    assert_eq!(buffer.iter().copied().collect::<Vec<_>>(), [0, 2]);
}

// Thematic breaks. A line consisting of up to three spaces of indentation and three or more matching `-`, `_`, or `*` characters,
// each optionally followed by spaces or tabs, is a thematic break and must not be combined with the line above or below it.
// ---
// Text between two breaks written with hyphens.
// ***
// Text between two breaks written with asterisks.
// ___
// - - -
// * * *
// _ _ _
// -	-	-
// The break above is separated by tabs.
//    ---
// The break above is indented by three spaces, the most that is allowed.
//
// The next line is indented by four spaces, so it is not a thematic break.
//     ---
// --
// --- a
// -*-
//
// None of the four lines above is a thematic break or a list element, so they should be joined.
